# DeepSeek is shared with the sibling Star Rail project when its .env exists.
# Set values here only when this project should override the shared values.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# A separate Wuthering Waves Feishu bot. Real sending stays disabled until true.
WUWA_FEISHU_WEBHOOK_URL=
WUWA_FEISHU_WEBHOOK_SECRET=
WUWA_FEISHU_SEND_ENABLED=false
